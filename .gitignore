# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local data (landing files + DuckDB)
data/

# Secrets (API keys) never go in git
.env
.env.*
!.env.example

# Terraform: local working files and state (state holds generated passwords; it lives in S3)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/backend.hcl
infra/terraform.tfvars
infra/crash.log
infra/tfplan
infra/plan.txt

# Local-only notes (e.g. docs/secrets.local.md): never pushed
*.local.md
